{
  "name": "tenon-workbench",
  "version": "1.0.7",
  "description": "TENON（榫）— 本地优先的多 Agent 与多协议 API 协同建筑工作台（Gemini / Codex / Claude Code / Ollama / DeepSeek / 无限节点画布）",
  "author": "jiuyang5354",
  "type": "module",
  "main": "electron/main.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiuyang5354/tenon-workbench.git"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "build:win": "node scripts/build-win.mjs",
    "build:dir": "node scripts/build-win.mjs --win dir",
    "test": "node --test tests/*.test.mjs",
    "gemini-ask": "node scripts/gemini-ask.mjs",
    "codex-worker": "node scripts/codex-worker.mjs",
    "codex-review": "node scripts/codex-review.mjs"
  },
  "build": {
    "appId": "com.jiuyang5354.tenon.workbench",
    "productName": "TENON",
    "artifactName": "TENON-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.mjs",
      "lib/**/*",
      "public/**/*",
      "templates/**/*",
      "scripts/**/*",
      "!scripts/build-win.mjs",
      "build/icon.ico",
      "package.json",
      "!dist/**",
      "!data/**",
      "!tests/**"
    ],
    "asarUnpack": [
      "scripts/**/*",
      "templates/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TENON 工作台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [
    "tenon",
    "gemini",
    "codex",
    "claude-code",
    "multi-agent",
    "orchestrator",
    "ai-workflow",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0"
  }
}
